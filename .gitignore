# Python virtual environments
venv/
.venv/

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Node dependencies
# The browser app does not require npm packages, but ignore this in case tooling is added later.
node_modules/

# Environment variables / local secrets
.env
.env.*
!.env.example

# OS-generated files
.DS_Store
Thumbs.db

# Windows metadata files created when files are downloaded/copied from Windows
*:Zone.Identifier

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local build/output folders
dist/
build/

# Temporary files
tmp/
temp/
*.tmp

# Editor / IDE files
.vscode/
.idea/

# Debug HTML files generated when Donghaeng Lottery blocks scripted requests
data/debug-dhlottery-*.html

# Keep lottery data files tracked.
# Do NOT ignore data/*.csv or data/*.json because GitHub Pages needs them.
